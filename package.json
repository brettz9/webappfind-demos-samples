{
  "name": "webappfind-demos-samples",
  "version": "0.7.0",
  "type": "module",
  "description": "Demos and sample files for exploring WebAppFind open web apps from desktop functionality",
  "scripts": {
    "tsc": "tsc",
    "open-svg": "open-cli http://localhost:8005/node_modules/svgedit/editor/svg-editor-es.html?extensions=ext-webappfind.js",
    "start": "static -p 8005",
    "submodules-init": "git submodule update --init --recursive",
    "submodules-fetch": "git submodule foreach --recursive git fetch",
    "submodules-merge": "git submodule foreach git merge origin master",
    "submodules": "run-s submodules-init submodules-fetch submodules-merge",
    "lint": "npm run eslint --",
    "eslint": "eslint --ext=js,md,html .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "browserslist": [
    "last 2 chrome versions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettz9/webappfind-demos-samples.git"
  },
  "keywords": [
    "webappfind",
    "openwith",
    "webapp"
  ],
  "author": "Brett Zamir",
  "contributors": [],
  "engines": {
    "node": ">=24.16.0"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brettz9/webappfind-demos-samples/issues"
  },
  "homepage": "https://github.com/brettz9/webappfind-demos-samples#readme",
  "dependencies": {
    "@node-static/node-static": "^0.10.0",
    "asm.js-lint": "^0.1.3",
    "base64-js": "^1.5.1",
    "jamilih": "^0.70.2",
    "open-cli": "^9.0.0",
    "svgedit": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-ash-nazg": "^43.2.3",
    "jxa-types": "^0.0.12",
    "typescript": "^7.0.2"
  }
}
